# --- Postgres ---
POSTGRES_USER=tesla_pool
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tesla_pool
POSTGRES_PORT=5432

# --- API ---
# Full connection string used by Prisma. When running via docker-compose,
# host should be the service name "postgres"; when running api locally
# against the dockerized db, use "localhost".
DATABASE_URL=postgresql://tesla_pool:change_me@localhost:5432/tesla_pool
JWT_SECRET=change_me_dev_secret
PORT=4000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
