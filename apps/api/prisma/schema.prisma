generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PASSENGER
  DRIVER
}

enum PoolStatus {
  OPEN
  LOCKED
  COMPLETED
  CANCELLED
}

enum RideStatus {
  REQUESTED
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

enum EventOutcome {
  SUCCESS
  CONFLICT
}

enum PaymentMethod {
  CASH
  TESLAPAY
}

model User {
  id                String   @id @default(cuid())
  name              String
  phone             String   @unique
  passwordHash      String
  role              Role
  // Simulated wallet, TESLAPAY-only — no real gateway per the PRD. Only
  // meaningful for passengers, but kept on User rather than a separate
  // Passenger model since this schema has no such split. No top-up
  // endpoint exists (explicitly out of scope); demo passengers are
  // seeded with a starting balance in prisma/seed.ts.
  walletBalancePaisa Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tesla        Tesla?
  rideRequests RideRequest[]

  @@map("users")
}

model Zone {
  id   String @id @default(cuid())
  name String @unique
  lat  Float?
  lng  Float?

  pickupRequests      RideRequest[] @relation("PickupZone")
  destinationRequests RideRequest[] @relation("DestinationZone")

  @@map("zones")
}

// One Tesla per driver (see @unique on driverId).
model Tesla {
  id        String   @id @default(cuid())
  driverId  String   @unique
  driver    User     @relation(fields: [driverId], references: [id])
  label     String
  capacity  Int
  isOnline  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pools Pool[]

  @@map("teslas")
}

// A single shared vehicle trip. seatsTaken is bounded by tesla.capacity
// and kept in sync with the sum of active RideRequest.seats in this pool.
model Pool {
  id         String     @id @default(cuid())
  teslaId    String
  tesla      Tesla      @relation(fields: [teslaId], references: [id])
  status     PoolStatus @default(OPEN)
  seatsTaken Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  rideRequests RideRequest[]

  @@map("pools")
}

// One passenger's membership in a Pool. Fare/status are tracked per
// passenger even though several RideRequests can share one Pool/vehicle.
model RideRequest {
  id                String     @id @default(cuid())
  passengerId       String
  passenger         User       @relation(fields: [passengerId], references: [id])
  pickupZoneId      String
  pickupZone        Zone       @relation("PickupZone", fields: [pickupZoneId], references: [id])
  destinationZoneId String
  destinationZone   Zone       @relation("DestinationZone", fields: [destinationZoneId], references: [id])
  seats             Int        @default(1)
  status            RideStatus @default(REQUESTED)
  farePaisa         Int?
  paymentMethod     PaymentMethod @default(CASH)
  poolId            String?
  pool              Pool?      @relation(fields: [poolId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  statusEvents RideStatusEvent[]

  @@map("ride_requests")
}

// Append-only audit trail of every attempted RideRequest status
// transition, including the losing side of a concurrency conflict — not
// just the write that won. SUCCESS rows are inserted in the same
// transaction as the write they describe, so they can never be out of
// sync with what actually happened. CONFLICT rows can't be: by
// definition the transaction that hit the conflict rolled back, so
// nothing written inside it (an event row included) could have
// survived. Those are written as a separate, immediate insert right
// after the conflict is detected, outside the aborted transaction — see
// rides.service.ts for exactly where the split happens.
model RideStatusEvent {
  id            String       @id @default(cuid())
  rideRequestId String
  rideRequest   RideRequest  @relation(fields: [rideRequestId], references: [id])
  fromStatus    RideStatus
  toStatus      RideStatus
  actorUserId   String
  actorRole     Role
  outcome       EventOutcome
  createdAt     DateTime     @default(now())

  @@map("ride_status_events")
}
